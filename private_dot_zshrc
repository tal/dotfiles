eval "$(/opt/homebrew/bin/brew shellenv)"

if [[ -n $GHOSTTY_RESOURCES_DIR ]] && [[ -f "$GHOSTTY_RESOURCES_DIR/shell-integration/zsh/ghostty-integration" ]]; then
  source "$GHOSTTY_RESOURCES_DIR"/shell-integration/zsh/ghostty-integration
fi

eval "$(starship init zsh)"

# Configure zsh-autocomplete
zstyle ':autocomplete:*complete*:*' insert-unambiguous yes  # Only insert the unambiguous part first
[ -f /opt/homebrew/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh ] && source /opt/homebrew/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh
[ -f ~/.letta-code/env ] && source ~/.letta-code/env

# fzf. `fzf --zsh` fully supersedes the old ~/.fzf.zsh installer stub, which just
# re-sourced the same completion/key-binding files plus a PATH entry that
# /opt/homebrew/bin already covers.
# -i makes fzf matching case-insensitive (it defaults to smart-case, so a single
# capital letter silently flips it to case-sensitive). zoxide's `zi` inherits
# this. Do NOT use _ZO_FZF_OPTS instead — that *replaces* zoxide's own fzf flags
# and you lose the preview pane, height, keybinds and --exact.
export FZF_DEFAULT_OPTS="-i"
source <(fzf --zsh)

# Override Tab binding AFTER both zsh-autocomplete AND fzf load — fzf's shell
# integration rebinds ^I to fzf-completion, so this has to come last to stick.
bindkey '^I' menu-select
bindkey "$terminfo[kcbt]" menu-select
# Inside the menu: Tab cycles forward, Shift+Tab cycles backward (instead of arrow-key navigation)
bindkey -M menuselect '^I' menu-complete
bindkey -M menuselect "$terminfo[kcbt]" reverse-menu-complete
# Escape the menu, restoring the command line to exactly what it was before Tab.
# zsh-autocomplete builds its own menuselect keymap and never binds ^G, so Zsh's
# default ^G -> send-break does not survive; without these there is NO clean exit
# (any unbound key leaves the menu but keeps the highlighted match inserted).
# ^[ costs one KEYTIMEOUT (0.4s) to disambiguate from the arrow-key sequences.
bindkey -M menuselect '^G' send-break
bindkey -M menuselect '^[' send-break

export PATH="$PATH:$HOME/.config/bin"

# Ripgrep configuration
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"

# dnscontrol shell completion
command -v dnscontrol >/dev/null 2>&1 && eval "$(dnscontrol shell-completion zsh)"

# bun completions
[ -s "/Users/tal/.bun/_bun" ] && source "/Users/tal/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# PATH=~/.console-ninja/.bin:$PATH

# datadog
[ -s ~/.zshrc.dd ] &&  source ~/.zshrc.dd

# dre-streams-jvm shortcuts
if [ -d "${HOME}/dd/dre-streams-jvm" ]; then
    source ${HOME}/dd/dre-streams-jvm/scripts/k8s-shortcuts
    source ${HOME}/dd/dre-streams-jvm/scripts/fzf-functions
    source ${HOME}/dd/dre-streams-jvm/scripts/helpers.sh
fi

# dre shortcuts
if [ -d "${HOME}/dd/dre" ]; then
    source ${HOME}/dd/dre/scripts/k8s_aliases.sh
    source ${HOME}/dd/dre/scripts/kafka.sh
fi

# yarn switch
[ -f "$HOME/.yarn/switch/env" ] && source "$HOME/.yarn/switch/env"

# Google Cloud SDK
[ -f "/opt/homebrew/share/google-cloud-sdk/path.zsh.inc" ] && source "/opt/homebrew/share/google-cloud-sdk/path.zsh.inc"

# NOTE: no `compinit` here on purpose. zsh-autocomplete (sourced above) runs its
# own compinit via Functions/Init/.autocomplete__compinit and manages its own
# dump file, so calling it again just re-scans for nothing. Verified: dropping it
# leaves $#_comps unchanged at 1759 and saves ~24ms per shell.
# To pass args to Autocomplete's compinit: zstyle '*:compinit' arguments -C

# Cache completion to speed things up. Same path Autocomplete uses for its dump,
# so there is one completion cache instead of two.
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh"

# Fuzzy matching of completions
zstyle ':completion:*' completer _complete _match _approximate
zstyle ':completion:*:match:*' original only
zstyle ':completion:*:approximate:*' max-errors 1 numeric

# Case-insensitive completion
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# List completions and cycle through them (don't auto-select first).
# No `zstyle ':completion:*' menu select` needed — Tab is bound directly to the
# menu-select widget above, which enters menu selection regardless of the zstyle.
setopt AUTO_LIST           # List choices on ambiguous completion
setopt LIST_AMBIGUOUS      # Show list immediately when ambiguous
unsetopt MENU_COMPLETE     # Don't insert first match immediately

# Format completion list with descriptions and group headers
zstyle ':completion:*' list-colors ''
zstyle ':completion:*:descriptions' format '%F{green}-- %d --%f'
zstyle ':completion:*:messages' format '%F{yellow}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}-- no matches found --%f'

# Group completions by type
zstyle ':completion:*' group-name ''

# Load custom zsh config files (aliases, functions, etc.)
if [ -d "$HOME/.config/zsh" ]; then
    for config_file in "$HOME/.config/zsh"/*.zsh; do
        [ -r "$config_file" ] && source "$config_file"
    done
fi

# zoxide (init, worktrunk-aware `z`/`zi`, tab completion, typeahead) lives in
# ~/.config/zsh/zzz-zoxide.zsh, sourced by the loop just above. It must load
# after `compinit`, which that loop already guarantees.

# Claude
export PATH="$HOME/.claude/local:$PATH"

command -v dd-gitsign >/dev/null 2>&1 && eval "$(dd-gitsign load-key)"

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

# Added by Craft Agent installer
export PATH="$HOME/.local/bin:$PATH"

if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

# kimi-code
export PATH="/Users/tal/.kimi-code/bin:$PATH"
